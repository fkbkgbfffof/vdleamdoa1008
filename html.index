
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

<title>Girls</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
  -webkit-tap-highlight-color:transparent;
}

html,body{
  width:100%;
  height:100%;
  overflow:hidden;
  background:#fff5f8;
  font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","SF Pro Text",Arial,sans-serif;
}

button{
  font-family:inherit;
  border:0;
}


/* =========================
   GIRLS SLIDER
========================= */

.profiles{
  width:100%;
  height:100dvh;

  display:flex;

  overflow-x:auto;
  overflow-y:hidden;

  scroll-snap-type:x mandatory;
  scrollbar-width:none;

  -webkit-overflow-scrolling:touch;
}

.profiles::-webkit-scrollbar{
  display:none;
}


/* =========================
   PROFILE
========================= */

.profile{
  position:relative;

  flex:0 0 100%;
  width:100%;
  height:100dvh;

  padding:
    15px
    15px
    calc(18px + env(safe-area-inset-bottom));

  scroll-snap-align:start;

  background:#fff5f8;

  display:flex;
  flex-direction:column;
}


/* =========================
   PHOTO
========================= */

.photo-card{
  position:relative;

  width:100%;
  flex:1;
  min-height:0;

  overflow:hidden;

  border-radius:28px;

  background:#f8dfe8;

  box-shadow:
    0 15px 40px rgba(205,80,119,.13);
}

.profile-photo{
  width:100%;
  height:100%;

  display:block;

  object-fit:cover;

  user-select:none;
  -webkit-user-drag:none;
}

.photo-card:after{
  content:"";

  position:absolute;
  inset:0;

  pointer-events:none;

  background:
    linear-gradient(
      to bottom,
      rgba(0,0,0,0) 48%,
      rgba(55,8,28,.08) 65%,
      rgba(55,8,28,.65) 100%
    );
}


/* =========================
   SLIDER DOTS
========================= */

.dots{
  position:fixed;

  z-index:20;

  top:
    calc(12px + env(safe-area-inset-top));

  left:50%;

  transform:translateX(-50%);

  display:flex;
  gap:5px;
}

.dot{
  width:27px;
  height:3px;

  border-radius:10px;

  background:rgba(255,255,255,.5);

  transition:.25s;
}

.dot.active{
  background:#fff;
}


/* =========================
   NAME + AGE
========================= */

.profile-info{
  position:absolute;

  z-index:5;

  left:29px;

  bottom:
    calc(102px + env(safe-area-inset-bottom));

  color:#fff;
}

.profile-name{
  font-size:32px;
  font-weight:750;
  letter-spacing:-.7px;
}

.profile-age{
  margin-top:4px;

  font-size:15px;

  color:rgba(255,255,255,.9);
}


/* =========================
   SEE CALENDAR
========================= */

.see-calendar{
  width:100%;
  height:57px;

  flex:0 0 57px;

  margin-top:13px;

  border-radius:18px;

  background:#ff4f7b;

  color:#fff;

  font-size:15px;
  font-weight:800;

  letter-spacing:.5px;

  box-shadow:
    0 10px 28px rgba(255,79,123,.25);

  cursor:pointer;

  transition:transform .15s;
}

.see-calendar:active{
  transform:scale(.97);
}


/* =========================
   CALENDAR OVERLAY
========================= */

.calendar-overlay{
  position:fixed;
  inset:0;

  z-index:100;

  display:flex;
  align-items:flex-end;
  justify-content:center;

  background:rgba(48,8,24,.38);

  backdrop-filter:blur(14px);
  -webkit-backdrop-filter:blur(14px);

  opacity:0;
  pointer-events:none;

  transition:opacity .25s;
}

.calendar-overlay.open{
  opacity:1;
  pointer-events:auto;
}


/* =========================
   CALENDAR MODAL
========================= */

.calendar-modal{
  width:100%;
  max-height:91dvh;

  overflow-y:auto;

  padding:
    13px
    16px
    calc(20px + env(safe-area-inset-bottom));

  border-radius:29px 29px 0 0;

  background:#fff;

  color:#2a1420;

  transform:translateY(35px);

  transition:transform .3s;

  box-shadow:
    0 -15px 60px rgba(126,38,72,.18);
}

.calendar-overlay.open .calendar-modal{
  transform:translateY(0);
}


/* =========================
   HANDLE
========================= */

.handle{
  width:39px;
  height:4px;

  margin:0 auto 17px;

  border-radius:20px;

  background:#ead3dc;
}


/* =========================
   GIRL HEADER
========================= */

.calendar-head{
  display:flex;
  align-items:center;
  gap:12px;

  margin-bottom:17px;
}

.calendar-girl{
  width:52px;
  height:52px;

  flex:0 0 52px;

  overflow:hidden;

  border-radius:16px;

  border:2px solid #ff4f7b;
}

.calendar-girl img{
  width:100%;
  height:100%;

  object-fit:cover;
}

.calendar-girl-name{
  font-size:19px;
  font-weight:750;
}

.calendar-girl-age{
  margin-top:3px;

  color:#a27e8c;

  font-size:12px;
}


/* =========================
   MONTH
========================= */

.month{
  display:flex;
  align-items:center;
  justify-content:space-between;

  margin-bottom:13px;
}

.month-title{
  font-size:18px;
  font-weight:750;
}

.month-arrow{
  width:36px;
  height:36px;

  border-radius:50%;

  background:#fff0f4;

  color:#d93161;

  font-size:22px;

  display:flex;
  align-items:center;
  justify-content:center;

  cursor:pointer;
}


/* =========================
   WEEKDAYS
========================= */

.weekdays,
.calendar-grid{
  display:grid;

  grid-template-columns:repeat(7,1fr);

  gap:6px;
}

.weekday{
  text-align:center;

  color:#b69aa5;

  font-size:9px;
  font-weight:700;

  padding-bottom:4px;
}


/* =========================
   CALENDAR DAY
========================= */

.calendar-day{
  position:relative;

  height:48px;

  border-radius:13px;

  border:1px solid #f2e3e8;

  background:#fff;

  color:#583846;

  display:flex;
  align-items:center;
  justify-content:center;

  font-size:12px;
  font-weight:650;

  cursor:pointer;

  transition:.15s;
}

.calendar-day.empty{
  visibility:hidden;
}

.calendar-day.past{
  opacity:.25;
  pointer-events:none;
}


/* =========================
   GIRL PHOTO ON DAY
========================= */

.calendar-day.girl-day{
  flex-direction:column;

  gap:2px;

  overflow:hidden;
}

.calendar-day.girl-day img{
  width:25px;
  height:25px;

  border-radius:8px;

  object-fit:cover;
}

.calendar-day.girl-day .day-number{
  font-size:8px;
}


/* =========================
   RED DAYS
========================= */

.calendar-day.red{
  background:#ffe1e8;

  border-color:#ffc4d1;

  color:#d52e5d;
}


/* =========================
   GREEN DAYS
========================= */

.calendar-day.green{
  background:#ddf7e9;

  border-color:#b7eacb;

  color:#218451;

  box-shadow:
    0 5px 15px rgba(66,188,122,.1);
}

.calendar-day.green:active{
  transform:scale(.94);
}


/* =========================
   SELECTED
========================= */

.calendar-day.selected{
  background:#43c77d;

  border-color:#43c77d;

  color:#fff;

  box-shadow:
    0 7px 20px rgba(67,199,125,.28);

  transform:scale(1.04);
}


/* =========================
   GET INSIGHTS
========================= */

.get-insights{
  width:100%;
  height:57px;

  margin-top:17px;

  border-radius:18px;

  background:#ff4f7b;

  color:#fff;

  font-size:15px;
  font-weight:800;

  letter-spacing:.6px;

  box-shadow:
    0 10px 28px rgba(255,79,123,.23);

  cursor:pointer;

  opacity:0;
  pointer-events:none;

  transform:translateY(8px);

  transition:
    opacity .25s,
    transform .25s;
}

.get-insights.visible{
  opacity:1;
  pointer-events:auto;

  transform:translateY(0);
}

.get-insights:active{
  transform:scale(.97);
}


/* =========================
   CONFETTI
========================= */

.confetti{
  position:fixed;

  z-index:500;

  top:-20px;

  width:8px;
  height:14px;

  pointer-events:none;

  animation:fall linear forwards;
}

@keyframes fall{
  to{
    transform:
      translateY(110dvh)
      rotate(720deg);

    opacity:0;
  }
}


/* =========================
   DESKTOP
========================= */

@media(min-width:700px){

  .calendar-overlay{
    align-items:center;
  }

  .calendar-modal{
    width:min(100%,620px);

    border-radius:29px;

    max-height:88dvh;
  }

}

</style>
</head>


<body>


<!-- =========================
     GIRLS
========================= -->

<div class="profiles" id="profiles">


  <!-- MILA -->

  <div
    class="profile"
    data-name="Mila"
    data-age="24"
    data-photo="https://i.ibb.co/8L89BcQb/Sophia-paige.jpg"
  >

    <div class="photo-card">

      <img
        class="profile-photo"
        src="https://i.ibb.co/8L89BcQb/Sophia-paige.jpg"
        alt="Mila"
        draggable="false"
      >

      <div class="profile-info">

        <div class="profile-name">
          Mila
        </div>

        <div class="profile-age">
          24
        </div>

      </div>

    </div>

    <button class="see-calendar">
      SEE CALENDAR
    </button>

  </div>


  <!-- RITA -->

  <div
    class="profile"
    data-name="Rita"
    data-age="26"
    data-photo="https://i.ibb.co/Rpv45XQX/6.jpg"
  >

    <div class="photo-card">

      <img
        class="profile-photo"
        src="https://i.ibb.co/Rpv45XQX/6.jpg"
        alt="Rita"
        draggable="false"
      >

      <div class="profile-info">

        <div class="profile-name">
          Rita
        </div>

        <div class="profile-age">
          26
        </div>

      </div>

    </div>

    <button class="see-calendar">
      SEE CALENDAR
    </button>

  </div>


  <!-- KIRA -->

  <div
    class="profile"
    data-name="Kira"
    data-age="23"
    data-photo="https://i.ibb.co/Sw9Qc56g/7.jpg"
  >

    <div class="photo-card">

      <img
        class="profile-photo"
        src="https://i.ibb.co/Sw9Qc56g/7.jpg"
        alt="Kira"
        draggable="false"
      >

      <div class="profile-info">

        <div class="profile-name">
          Kira
        </div>

        <div class="profile-age">
          23
        </div>

      </div>

    </div>

    <button class="see-calendar">
      SEE CALENDAR
    </button>

  </div>

</div>


<!-- =========================
     SLIDER DOTS
========================= -->

<div class="dots" id="dots">

  <div class="dot active"></div>
  <div class="dot"></div>
  <div class="dot"></div>

</div>


<!-- =========================
     CALENDAR
========================= -->

<div
  class="calendar-overlay"
  id="calendarOverlay"
>

  <div class="calendar-modal">

    <div class="handle"></div>

    <div
      class="calendar-head"
      id="calendarHead"
    ></div>


    <div class="month">

      <button
        class="month-arrow"
        id="prevMonth"
      >
        ‹
      </button>

      <div
        class="month-title"
        id="monthTitle"
      ></div>

      <button
        class="month-arrow"
        id="nextMonth"
      >
        ›
      </button>

    </div>


    <div class="weekdays">

      <div class="weekday">SUN</div>
      <div class="weekday">MON</div>
      <div class="weekday">TUE</div>
      <div class="weekday">WED</div>
      <div class="weekday">THU</div>
      <div class="weekday">FRI</div>
      <div class="weekday">SAT</div>

    </div>


    <div
      class="calendar-grid"
      id="calendarGrid"
    ></div>


    <button
      class="get-insights"
      id="getInsights"
    >
      GET INSIGHTS
    </button>

  </div>

</div>


<script>

/* =========================
   ELEMENTS
========================= */

const profiles =
  document.getElementById("profiles");

const dots =
  document.querySelectorAll(".dot");

const overlay =
  document.getElementById("calendarOverlay");

const calendarHead =
  document.getElementById("calendarHead");

const monthTitle =
  document.getElementById("monthTitle");

const calendarGrid =
  document.getElementById("calendarGrid");

const getInsights =
  document.getElementById("getInsights");

const prevMonth =
  document.getElementById("prevMonth");

const nextMonth =
  document.getElementById("nextMonth");


/* =========================
   STATE
========================= */

let activeProfile = null;

let selectedDate = null;

let currentMonth =
  new Date().getMonth();

let currentYear =
  new Date().getFullYear();

const calendarData = {};


/* =========================
   MONTHS
========================= */

const months = [
  "January",
  "February",
  "March",
  "April",
  "May",
  "June",
  "July",
  "August",
  "September",
  "October",
  "November",
  "December"
];


/* =========================
   DATE KEY
========================= */

function dateKey(
  year,
  month,
  day
){

  return (
    year +
    "-" +
    month +
    "-" +
    day
  );

}


/* =========================
   RANDOM DATES
========================= */

function createRandomDays(){

  const total =
    new Date(
      currentYear,
      currentMonth + 1,
      0
    ).getDate();


  const today =
    new Date();

  today.setHours(0,0,0,0);


  const available = [];


  for(
    let day = 1;
    day <= total;
    day++
  ){

    const date =
      new Date(
        currentYear,
        currentMonth,
        day
      );


    if(date >= today){

      available.push(day);

    }

  }


  available.sort(
    () => Math.random() - .5
  );


  return {

    green:
      available.slice(0,4),

    red:
      available.slice(4,8)

  };

}


/* =========================
   GET CALENDAR DATA
========================= */

function getCalendarData(){

  const key =
    activeProfile.name +
    "-" +
    currentYear +
    "-" +
    currentMonth;


  if(!calendarData[key]){

    calendarData[key] =
      createRandomDays();

  }


  return calendarData[key];

}


/* =========================
   OPEN CALENDAR
========================= */

function openCalendar(profile){

  activeProfile =
    profile;

  selectedDate = null;

  currentMonth =
    new Date().getMonth();

  currentYear =
    new Date().getFullYear();


  calendarGrid.style.display =
    "grid";

  document.querySelector(".month").style.display =
    "flex";

  document.querySelector(".weekdays").style.display =
    "grid";

  getInsights.style.display =
    "block";

  getInsights.classList.remove(
    "visible"
  );


  renderCalendarHead();

  renderCalendar();


  overlay.classList.add(
    "open"
  );

}


/* =========================
   HEADER
========================= */

function renderCalendarHead(){

  calendarHead.innerHTML = `

    <div class="calendar-girl">

      <img
        src="${activeProfile.photo}"
        alt="${activeProfile.name}"
      >

    </div>

    <div>

      <div class="calendar-girl-name">
        ${activeProfile.name}
      </div>

      <div class="calendar-girl-age">
        ${activeProfile.age} years old
      </div>

    </div>

  `;

}


/* =========================
   RENDER CALENDAR
========================= */

function renderCalendar(){

  calendarGrid.innerHTML = "";


  monthTitle.textContent =
    months[currentMonth] +
    " " +
    currentYear;


  const data =
    getCalendarData();


  const firstDay =
    new Date(
      currentYear,
      currentMonth,
      1
    ).getDay();


  const total =
    new Date(
      currentYear,
      currentMonth + 1,
      0
    ).getDate();


  const today =
    new Date();

  today.setHours(0,0,0,0);


  /*
    EMPTY CELLS
  */

  for(
    let i=0;
    i<firstDay;
    i++
  ){

    const empty =
      document.createElement("div");

    empty.className =
      "calendar-day empty";

    calendarGrid.appendChild(
      empty
    );

  }


  /*
    DAYS
  */

  for(
    let day=1;
    day<=total;
    day++
  ){

    const cell =
      document.createElement("div");


    cell.className =
      "calendar-day";


    const number =
      document.createElement("span");

    number.className =
      "day-number";

    number.textContent =
      day;


    const date =
      new Date(
        currentYear,
        currentMonth,
        day
      );


    /*
      PAST
    */

    if(date < today){

      cell.classList.add(
        "past"
      );

    }


    /*
      GREEN
    */

    if(
      data.green.includes(day)
    ){

      cell.classList.add(
        "green"
      );

    }


    /*
      RED
    */

    if(
      data.red.includes(day)
    ){

      cell.classList.add(
        "red"
      );

    }


    /*
      ADD PHOTO TO
      SOME CALENDAR DAYS
    */

    const showGirl =
      data.green.includes(day) ||
      data.red.includes(day);


    if(
      showGirl &&
      !cell.classList.contains("past")
    ){

      cell.classList.add(
        "girl-day"
      );


      const img =
        document.createElement("img");

      img.src =
        activeProfile.photo;

      img.alt =
        activeProfile.name;


      cell.appendChild(img);

    }


    cell.appendChild(
      number
    );


    /*
      GREEN CLICK
    */

    if(
      data.green.includes(day) &&
      !cell.classList.contains("past")
    ){

      cell.addEventListener(
        "click",
        () => {

          document
            .querySelectorAll(
              ".calendar-day.selected"
            )
            .forEach(
              item =>
                item.classList.remove(
                  "selected"
                )
            );


          cell.classList.add(
            "selected"
          );


          selectedDate =
            dateKey(
              currentYear,
              currentMonth,
              day
            );


          getInsights.classList.add(
            "visible"
          );

        }
      );

    }


    calendarGrid.appendChild(
      cell
    );

  }

}


/* =========================
   SEE CALENDAR
========================= */

document
  .querySelectorAll(".profile")
  .forEach(profile => {

    const button =
      profile.querySelector(
        ".see-calendar"
      );


    button.addEventListener(
      "click",
      () => {

        openCalendar({

          name:
            profile.dataset.name,

          age:
            profile.dataset.age,

          photo:
            profile.dataset.photo

        });

      }
    );

  });


/* =========================
   SLIDER DOTS
========================= */

profiles.addEventListener(
  "scroll",
  () => {

    const index =
      Math.round(
        profiles.scrollLeft /
        profiles.clientWidth
      );


    dots.forEach(
      (dot,i) => {

        dot.classList.toggle(
          "active",
          i === index
        );

      }
    );

  },
  {
    passive:true
  }
);


/* =========================
   PREVIOUS MONTH
========================= */

prevMonth.addEventListener(
  "click",
  () => {

    currentMonth--;

    if(
      currentMonth < 0
    ){

      currentMonth = 11;
      currentYear--;

    }


    selectedDate = null;

    getInsights.classList.remove(
      "visible"
    );


    renderCalendar();

  }
);


/* =========================
   NEXT MONTH
========================= */

nextMonth.addEventListener(
  "click",
  () => {

    currentMonth++;

    if(
      currentMonth > 11
    ){

      currentMonth = 0;
      currentYear++;

    }


    selectedDate = null;

    getInsights.classList.remove(
      "visible"
    );


    renderCalendar();

  }
);


/* =========================
   GET INSIGHTS
========================= */

getInsights.addEventListener(
  "click",
  () => {

    if(!selectedDate){
      return;
    }


    /*
      IMPORTANT:
      No final text.
      Only confetti.
    */

    calendarHead.innerHTML = "";

    calendarGrid.style.display =
      "none";

    document.querySelector(
      ".month"
    ).style.display =
      "none";

    document.querySelector(
      ".weekdays"
    ).style.display =
      "none";

    getInsights.style.display =
      "none";


    createConfetti();

  }
);


/* =========================
   CONFETTI
========================= */

function createConfetti(){

  const colors = [

    "#ff4f7b",
    "#ff8faf",
    "#ffd1dd",
    "#43c77d",
    "#ffcc66",
    "#ffffff"

  ];


  for(
    let i=0;
    i<100;
    i++
  ){

    const piece =
      document.createElement(
        "div"
      );


    piece.className =
      "confetti";


    piece.style.left =
      Math.random() * 100 +
      "vw";


    piece.style.background =
      colors[
        Math.floor(
          Math.random() *
          colors.length
        )
      ];


    piece.style.width =
      (5 + Math.random()*5) +
      "px";


    piece.style.height =
      (8 + Math.random()*9) +
      "px";


    piece.style.animationDuration =
      (2 + Math.random()*2.5) +
      "s";


    piece.style.animationDelay =
      Math.random() * .6 +
      "s";


    document.body.appendChild(
      piece
    );


    setTimeout(
      () => piece.remove(),
      5000
    );

  }

}


/* =========================
   CLOSE BY BACKGROUND
========================= */

overlay.addEventListener(
  "click",
  event => {

    if(
      event.target === overlay
    ){

      overlay.classList.remove(
        "open"
      );

    }

  }
);


/* =========================
   SWIPE DOWN TO CLOSE
========================= */

let startY = 0;

const modal =
  document.querySelector(
    ".calendar-modal"
  );


modal.addEventListener(
  "touchstart",
  event => {

    startY =
      event.touches[0].clientY;

  },
  {
    passive:true
  }
);


modal.addEventListener(
  "touchend",
  event => {

    const endY =
      event.changedTouches[0].clientY;


    if(
      endY - startY > 100 &&
      modal.scrollTop === 0
    ){

      overlay.classList.remove(
        "open"
      );

    }

  },
  {
    passive:true
  }
);

</script>

</body>
</html>
```
